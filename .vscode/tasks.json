{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RISCue: pipeline smoke (WSL)",
      "type": "process",
      "command": "make",
      "args": [
        "pipeline-smoke",
        "pipeline-jump"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PIPELINE_PROTECTION": "TMR",
          "ALLOW_EXPERIMENTAL_PARITY": "0"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "detail": "Use a VS Code window connected to Ubuntu-24.04. Results stay local in build/."
    },
